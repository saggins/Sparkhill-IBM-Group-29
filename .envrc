# Auto-activate the project venv (create it on first load).
if [[ ! -d .venv ]]; then
  log_status "creating .venv and installing requirements"
  python3 -m venv .venv
  .venv/bin/pip install -q -r requirements.txt
fi

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

watch_file requirements.txt
